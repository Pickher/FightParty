[sub_resource type="Shader" id="FloorShader"]
code = "shader_type spatial;
render_mode diffuse_burley, specular_disabled;
varying vec2 stage;
void vertex() { stage = VERTEX.xz; }
void fragment() {
    vec2 cell = stage * 3.0;
    vec2 width = max(fwidth(cell), vec2(0.001));
    vec2 edge = abs(fract(cell + 0.5) - 0.5) / width;
    float line = 1.0 - smoothstep(0.0, 0.95, min(edge.x, edge.y));
    ALBEDO = mix(vec3(0.080, 0.113, 0.137), vec3(0.122, 0.162, 0.182), line);
    ROUGHNESS = 0.97;
}"

