void gf_TESTChangeRace (int lp_player, string lp_race) {
    // Automatic Variable Declarations
    string auto51489969_val;

    // Implementation
    PlayerSetRace(lp_player, lp_race);
    auto51489969_val = lp_race;
    if (auto51489969_val == "Terr") {
        gv_nSKXP_B00012[lp_player] = 0;
        gv_workers[lp_player] = "SCV";
        TechTreeAbilityAllow(lp_player, AbilityCommand("Buildgas", 1), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("Buildgas", 2), false);
        TechTreeAbilityAllow(lp_player, AbilityCommand("Buildgas", 0), false);
        TechTreeAbilityAllow(lp_player, AbilityCommand("TerranBuild2", 6), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("TerranBuild2", 5), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("ZergBuild2", 0), false);
        TechTreeAbilityAllow(lp_player, AbilityCommand("ZergBuild2", 1), false);
        TechTreeAbilityAllow(lp_player, AbilityCommand("ProtossBuild2", 7), false);
        TechTreeAbilityAllow(lp_player, AbilityCommand("ProtossBuild2", 7), false);
    }
    else if (auto51489969_val == "Zerg") {
        gv_nSKXP_B00012[lp_player] = 1;
        gv_workers[lp_player] = "Drone";
