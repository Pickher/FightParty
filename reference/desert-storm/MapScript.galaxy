// Trigger: Teleport to Battle
//--------------------------------------------------------------------------------------------------
bool gt_TeleporttoBattle_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(gf_E69DA1E4BBB6E8BF87E6BBA4E4B8A8E5B7A5E4BABAE58D95E4BD8D(EventUnit()))) {
            return false;
        }

        if (!((gv_spawncount <= 61))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    SoundPlay(SoundLink("Shuttle_Load", 0), PlayerGroupSingle(EventPlayer()), 100.0, 0.0);
    if (((UnitGetOwner(EventUnit()) == gv_playerSlot[1]) || (UnitGetOwner(EventUnit()) == gv_playerSlot[2]) || (UnitGetOwner(EventUnit()) == gv_playerSlot[3]))) {
        Wait(0.0625, c_timeGame);
        gf_TeleportDZ(EventPlayer(), 0, RegionGetBoundsMax(RegionFromId(19)));
        UnitIssueOrder(EventUnit(), Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        UnitSetPosition(EventUnit(), PointWithOffset(RegionGetCenter(RegionFromId(19)), -2.0, -3.0), true);
        gf_WorkerinBattle(EventUnit());
        if (((UnitGetType(EventUnit()) == "SCV") || (UnitGetType(EventUnit()) == "Probe") || (UnitGetType(EventUnit()) == "Drone"))) {
            if ((UnitHasBehavior2(gv_e5869BE8A194E690ADE6A1A3[UnitGetOwner(EventUnit())], "BOSS02VoidPylonPowerSourceOPEN") == false)) {
                UnitSetPosition(gv_e5869BE8A194E690ADE6A1A3[UnitGetOwner(EventUnit())], PointWithOffset(PointWithOffset(RegionGetCenter(RegionFromId(19)), -2.0, -3.0), RandomFixed(-2.0, 2.0), RandomFixed(-2.0, 2.0)), true);
            }

        }

    }

    if (((UnitGetOwner(EventUnit()) == gv_playerSlot[4]) || (UnitGetOwner(EventUnit()) == gv_playerSlot[5]) || (UnitGetOwner(EventUnit()) == gv_playerSlot[6]))) {
        Wait(0.0625, c_timeGame);
