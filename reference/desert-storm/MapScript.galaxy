//--------------------------------------------------------------------------------------------------
// Trigger: Core Connect
//--------------------------------------------------------------------------------------------------
bool gt_CoreConnect_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGetOwner(EventUnit()) == EventPlayer())) {
        if (((UnitGetType(EventUnitTargetUnit()) == "DSBeacon_T") || (UnitGetType(EventUnitTargetUnit()) == "DSBeacon_Z") || (UnitGetType(EventUnitTargetUnit()) == "DSBeacon_P"))) {
            if ((UnitGetOwner(EventUnit()) != gv_nSKXP_B00041[0]) && (UnitGetOwner(EventUnit()) != gv_nSKXP_B00041[1]) && (UnitGetOwner(EventUnit()) != gv_nSKXP_B00041[2]) && (UnitGetOwner(EventUnit()) != gv_nSKXP_B00041[3])) {
                if ((PlayerGetAlliance(EventPlayer(), c_allianceIdVision, UnitGetOwner(EventUnitTargetUnit())) == true) && (PlayerGetAlliance(EventPlayer(), c_allianceIdControl, UnitGetOwner(EventUnitTargetUnit())) == false)) {
                    libNtve_gf_SetAllianceOneWay(EventPlayer(), UnitGetOwner(EventUnitTargetUnit()), libNtve_ge_AllianceSetting_AllyWithSharedVisionAndControl);
                    UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, TextExpressionAssemble("Param/Expression/4B84171E"));
                }
                else {
                    libNtve_gf_SetAllianceOneWay(EventPlayer(), UnitGetOwner(EventUnitTargetUnit()), libNtve_ge_AllianceSetting_AllyWithSharedVision);
                    UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, TextExpressionAssemble("Param/Expression/860F56FF"));
                }
            }
            else {
                UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, TextExpressionAssemble("Param/Expression/E80E8AC2"));
            }
        }
        else {
            UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, TextExpressionAssemble("Param/Expression/863BA910"));
        }
    }
    else {
        UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, TextExpressionAssemble("Param/Expression/5028C958"));
    }
    return true;
}

