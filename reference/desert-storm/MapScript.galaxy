//--------------------------------------------------------------------------------------------------
bool gt_Practicekill_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnitTargetUnit()) != "VespeneGeyser"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "DestructibleRock2x6Vertical"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "DSBeacon_T"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "DSBeacon_Z"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "DSBeacon_P"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "SSHX_T"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "SSHX_Z"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "SSHX_P"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "XSHX_T"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "XSHX_Z"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "XSHX_P"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "SCV"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "Drone"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "Probe"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "HighYieldMineralFieldHigh7"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "HighYieldMineralFieldHigh7_2"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "HighYieldMineralFieldHigh7_3"))) {
            return false;
        }

        if (!((UnitGetType(EventUnitTargetUnit()) != "HighYieldMineralFieldHigh7_4"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitRemove(EventUnitTargetUnit());
    if ((RegionContainsPoint(RegionFromId(23), EventUnitTargetPoint()) == false)) {
        UIDisplayMessage(PlayerGroupSingle(UnitGetOwner(EventUnitTargetUnit())), c_messageAreaSubtitle, StringExternal("Param/Value/4D0974CA"));
        PlayerModifyPropertyInt(UnitGetOwner(EventUnitTargetUnit()), c_playerPropMinerals, c_playerPropOperAdd, CatalogFieldValueGetAsInt(c_gameCatalogUnit, UnitGetType(EventUnitTargetUnit()), "CostResource[" + IntToString(0) + "]", UnitGetOwner(EventUnitTargetUnit())));
