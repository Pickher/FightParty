    if (testConds) {
        if (!((gv_spawncount <= 64))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_spawnerT2 >= gv_aIPlayerMax)) {
        gv_spawnerT2 = 4;
    }
    else {
        gv_spawnerT2 = (gv_spawnerT2 + 1);
    }
    if ((GameIsTestMap(false) == false)) {
    }
    else {
        TextExpressionSetToken("Param/Expression/399F35D4", "A", IntToText(gv_spawnerT1));
        TextExpressionSetToken("Param/Expression/399F35D4", "B", IntToText(gv_spawnerT2));
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, TextExpressionAssemble("Param/Expression/399F35D4"));
    }
    return true;
}

