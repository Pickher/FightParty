bool gt_SpawnTimer_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    while (true) {
        if ((gv_flag_SpawnTimer == 0)) {
            if ((gv_time_SpawnTimer > 0)) {
                if ((TriggerIsEnabled(gt__00006E4B8A8E6B3A2E6ACA1E69BB4E696B0E4B8A8E6B3A2E6ACA1E58092E695B0E69BB4E696B0E8AEA1E697B6E599A8E5AE8CE68890) == true)) {
                    TriggerExecute(gt__00006E4B8A8E6B3A2E6ACA1E69BB4E696B0E4B8A8E6B3A2E6ACA1E58092E695B0E69BB4E696B0E8AEA1E697B6E599A8E5AE8CE68890, true, false);
                }

                gv_time_SpawnTimer -= 1;
                Wait(1.0, c_timeGame);
            }
            else {
                if ((TriggerIsEnabled(gt__00006E4B8A8E6B3A2E6ACA1E69BB4E696B0E4B8A8E6B3A2E6ACA1E58092E695B0E69BB4E696B0E8AEA1E697B6E599A8E5AE8CE68890) == true)) {
                    TriggerExecute(gt__00006E4B8A8E6B3A2E6ACA1E69BB4E696B0E4B8A8E6B3A2E6ACA1E58092E695B0E69BB4E696B0E8AEA1E697B6E599A8E5AE8CE68890, true, false);
                }

                if ((TriggerIsEnabled(gt_TimerexpiresTimerReset) == true)) {
                    TriggerExecute(gt_TimerexpiresTimerReset, true, false);
                }

                if ((TriggerIsEnabled(gt_Battle60) == true)) {
                    TriggerExecute(gt_Battle60, true, false);
                }

                if ((TriggerIsEnabled(gt_TimerExpiresSpawn1) == true)) {
                    TriggerExecute(gt_TimerExpiresSpawn1, true, false);
                    if ((GameAttributeGameValue("[bnet:local/0.0/177773]1") == "0011")) {
                        TriggerExecute(gt_TimerExpiresSpawn1, true, false);
