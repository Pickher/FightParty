    if (!runActions) {
        return true;
    }

    if ((gv_spawncount == 5)) {
        TriggerExecute(gt_Mayday, true, false);
    }

    if ((gv_spawncount < 10)) {
        TriggerExecute(gt_CrashedActor, true, false);
    }
    else {
        TriggerEnable(TriggerGetCurrent(), false);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StoryMain_Init () {
    gt_StoryMain = TriggerCreate("gt_StoryMain_Func");
    TriggerAddEventTimer(gt_StoryMain, gv_spawnTimer);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Mission Mian
//--------------------------------------------------------------------------------------------------
bool gt_MissionMian_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((GameAttributeGameValue("[bnet:local/0.0/177773]1") != "0002"))) {
            return false;
        }

        if (!((GameAttributeGameValue("[bnet:local/0.0/177773]1") != "0009"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(90.0, c_timeGame);
    TriggerExecute(gt_VioletMisssionMenu, true, false);
    TriggerExecute(gt_YellowMisssionMenu, true, false);
    return true;
}

