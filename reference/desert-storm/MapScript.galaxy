            return false;
        }

        if (!((UnitTypeTestFlag(UnitGetType(EventUnit()), c_unitFlagMissile) == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(EventUnit(), Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    UnitSetPosition(EventUnit(), gv_startLocation[EventPlayer()], false);
    if (((UnitGetType(EventUnit()) == "SCV") || (UnitGetType(EventUnit()) == "Probe") || (UnitGetType(EventUnit()) == "Drone") || (UnitGetType(EventUnit()) == "Drone2") || (UnitGetType(EventUnit()) == "Probe2") || (UnitGetType(EventUnit()) == "SCV2")) && (UnitGetOwner(EventUnit()) != 7) && (UnitGetOwner(EventUnit()) != 8)) {
        gf_WorkerinBase(EventUnit());
        CameraPan(EventPlayer(), gv_startLocation[EventPlayer()], 1.0, -1, 10.0, false);
        SoundPlay(SoundLink("UI_GenericError", 0), PlayerGroupSingle(UnitGetOwner(EventUnit())), 100.0, 0.0);
    }

    UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, StringExternal("Param/Value/763F7B38"));
    return true;
}

