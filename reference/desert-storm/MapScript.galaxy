// Trigger: AlarakTemplarSet
//--------------------------------------------------------------------------------------------------
bool gt_AlarakTemplarSet_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_eventUnit;
    string lv_alarakTemplar;
    int lv_player;
    unitgroup lv_alarakTemplarGroup;
    int lv_stackCount;
    string lv_msg;

    // Automatic Variable Declarations
    unitgroup autoB430EDD0_g;
    int autoB430EDD0_u;
    unit autoB430EDD0_var;

    // Variable Initialization
    lv_eventUnit = EventPlayerEffectUsedUnit(c_effectUnitSource);
    lv_alarakTemplar = EventPlayerEffectUsedUnitType(c_effectUnitSource);
    lv_player = EventPlayerEffectUsedUnitOwner(c_effectPlayerSource);
    lv_alarakTemplarGroup = UnitGroup(lv_alarakTemplar, lv_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_msg = "";

    // Actions
    if (!runActions) {
        return true;
    }

    if (((UnitIsAlive(gv_alarakTemplarTarget[lv_player]) == false) || (gv_alarakTemplarTarget[lv_player] == null))) {
        gv_alarakTemplarTarget[lv_player] = UnitGroupRandomUnit(lv_alarakTemplarGroup, c_unitCountAlive);
        UnitGroupRemove(lv_alarakTemplarGroup, gv_alarakTemplarTarget[lv_player]);
        autoB430EDD0_g = lv_alarakTemplarGroup;
        autoB430EDD0_u = UnitGroupCount(autoB430EDD0_g, c_unitCountAll);
        for (;; autoB430EDD0_u -= 1) {
            autoB430EDD0_var = UnitGroupUnitFromEnd(autoB430EDD0_g, autoB430EDD0_u);
            if (autoB430EDD0_var == null) { break; }
            UnitCreateEffectUnit(gv_alarakTemplarTarget[lv_player], "AscendantSacrificeSelfBuff1", gv_alarakTemplarTarget[lv_player]);
            lv_stackCount = UnitBehaviorCount(gv_alarakTemplarTarget[lv_player], "AscendantSacrificeSelfBuff1");
            lv_msg = ("Signal " + IntToString(lv_stackCount));
            UnitSetScale(gv_alarakTemplarTarget[lv_player], (100.0 + (lv_stackCount * 4.0)), (100.0 + (lv_stackCount * 4.0)), (100.0 + (lv_stackCount * 4.0)));
            ActorScopeSend(ActorScopeFromUnit(gv_alarakTemplarTarget[lv_player]), (lv_msg));
            UnitRemove(autoB430EDD0_var);
        }
    }
    else {
        if (((lv_eventUnit == gv_alarakTemplarTarget[lv_player]) || (UnitIsAlive(lv_eventUnit) == false))) {
            return true;
        }

        UnitCreateEffectUnit(gv_alarakTemplarTarget[lv_player], "AscendantSacrificeSelfBuff1", gv_alarakTemplarTarget[lv_player]);
        if ((UnitHasBehavior2(lv_eventUnit, "Behavior_TDLLHXSGFXT") == true)) {
            UnitBehaviorAdd(gv_alarakTemplarTarget[lv_player], "Behavior_TDLLHXSGFXT", gv_alarakTemplarTarget[lv_player], 1);
        }

        lv_stackCount = UnitBehaviorCount(gv_alarakTemplarTarget[lv_player], "AscendantSacrificeSelfBuff1");
        lv_msg = ("Signal " + IntToString(lv_stackCount));
        UnitSetScale(gv_alarakTemplarTarget[lv_player], (100.0 + (lv_stackCount * 4.0)), (100.0 + (lv_stackCount * 4.0)), (100.0 + (lv_stackCount * 4.0)));
        ActorScopeSend(ActorScopeFromUnit(gv_alarakTemplarTarget[lv_player]), (lv_msg));
        UnitRemove(lv_eventUnit);
    }
    return true;
}

