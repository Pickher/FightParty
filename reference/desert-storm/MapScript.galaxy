    TriggerAddEventUnitAbility(gt_CoreConnect, null, AbilityCommand("Button_HX_ZTLJ", 0), c_unitAbilStageComplete, false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Energy Teleport
//--------------------------------------------------------------------------------------------------
bool gt_EnergyTeleport_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_energyCaster;
    fixed lv_energyTarget;
    fixed lv_energyTransport;
    unit lv_energyTargetUnit;
    unit lv_energyCasterUnit;

    // Automatic Variable Declarations
    abilcmd auto48656C7E_val;
    abilcmd autoCDE220DC_val;

    // Variable Initialization
    lv_energyCaster = UnitGetPropertyFixed(gv_cU_GPUnit[UnitGetOwner(EventUnit())], c_unitPropEnergy, c_unitPropCurrent);
    lv_energyTransport = 15.0;
    lv_energyCasterUnit = gv_cU_GPUnit[UnitGetOwner(EventUnit())];

    // Conditions
    if (testConds) {
        if (!((lv_energyCaster > 0.0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((PlayerGroupHasPlayer(gv_team1, UnitGetOwner(EventUnit())) == true)) {
        auto48656C7E_val = EventUnitAbility();
        if (auto48656C7E_val == AbilityCommand("mineteleport1R", 0)) {
            lv_energyTargetUnit = gv_cU_GPUnit[gv_playerSlot[1]];
        }
        else if (auto48656C7E_val == AbilityCommand("mineteleport2R", 0)) {
            lv_energyTargetUnit = gv_cU_GPUnit[gv_playerSlot[2]];
        }
        else if (auto48656C7E_val == AbilityCommand("mineteleport3R", 0)) {
            lv_energyTargetUnit = gv_cU_GPUnit[gv_playerSlot[3]];
        }
        else {
        }
        UIDisplayMessage(gv_team1, c_messageAreaSubtitle, (gv_player[UnitGetOwner(EventUnit())] + StringExternal("Param/Value/70B199F5") + gv_player[UnitGetOwner(lv_energyTargetUnit)] + StringExternal("Param/Value/AD7419FD")));
    }

    if ((PlayerGroupHasPlayer(gv_team2, UnitGetOwner(EventUnit())) == true)) {
        autoCDE220DC_val = EventUnitAbility();
        if (autoCDE220DC_val == AbilityCommand("mineteleport1L", 0)) {
            lv_energyTargetUnit = gv_cU_GPUnit[gv_playerSlot[4]];
        }
        else if (autoCDE220DC_val == AbilityCommand("mineteleport2L", 0)) {
            lv_energyTargetUnit = gv_cU_GPUnit[gv_playerSlot[5]];
        }
        else if (autoCDE220DC_val == AbilityCommand("mineteleport3L", 0)) {
            lv_energyTargetUnit = gv_cU_GPUnit[gv_playerSlot[6]];
        }
        else {
        }
        UIDisplayMessage(gv_team2, c_messageAreaSubtitle, (gv_player[UnitGetOwner(EventUnit())] + StringExternal("Param/Value/410E2463") + gv_player[UnitGetOwner(lv_energyTargetUnit)] + StringExternal("Param/Value/BD9C3869")));
    }

    if ((lv_energyCaster < 5.0)) {
        lv_energyTransport = lv_energyCaster;
    }

    SoundPlayForPlayer(SoundLink("SOA_ChronoSurge", -1), c_maxPlayers, PlayerGroupSingle(EventPlayer()), 100.0, 0.0);
    SoundPlayForPlayer(SoundLink("SOA_ChronoSurge", -1), c_maxPlayers, PlayerGroupAlliance(c_playerGroupAlly, EventPlayer()), 100.0, 0.0);
    UnitSetPropertyFixed(lv_energyCasterUnit, c_unitPropEnergy, (lv_energyCaster - lv_energyTransport));
    lv_energyTarget = UnitGetPropertyFixed(lv_energyTargetUnit, c_unitPropEnergy, c_unitPropCurrent);
    lv_energyTarget = (lv_energyTarget + lv_energyTransport);
    UnitSetPropertyFixed(lv_energyTargetUnit, c_unitPropEnergy, lv_energyTarget);
    if (((GameAttributeGameValue("[bnet:local/0.0/177773]1") == "0013") || (GameAttributeGameValue("[bnet:local/0.0/177773]1") == "0011"))) {
        gf_CU_GPSoAUpdateVitalsLKXE(UnitGetOwner(EventUnit()), EventPlayer());
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_EnergyTeleport_Init () {
    gt_EnergyTeleport = TriggerCreate("gt_EnergyTeleport_Func");
    TriggerAddEventUnitAbility(gt_EnergyTeleport, null, AbilityCommand("mineteleport1R", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_EnergyTeleport, null, AbilityCommand("mineteleport1L", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_EnergyTeleport, null, AbilityCommand("mineteleport2R", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_EnergyTeleport, null, AbilityCommand("mineteleport2L", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_EnergyTeleport, null, AbilityCommand("mineteleport3R", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_EnergyTeleport, null, AbilityCommand("mineteleport3L", 0), c_unitAbilStageComplete, false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Zone Control
//--------------------------------------------------------------------------------------------------
bool gt_ZoneControl_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) != 0))) {
            return false;
        }

        if (!((gv_safety[UnitGetOwner(EventUnit())] == 0))) {
            return false;
        }

        if (!((CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(EventUnit()), "TechAliasArray[" + IntToString(2) + "]", UnitGetOwner(EventUnit())) == "4"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitAbilityEnable(EventUnit(), "Teleport", false);
    UnitIssueOrder(EventUnit(), Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    UnitSetPosition(EventUnit(), gv_startLocation[EventPlayer()], false);
    SoundPlay(SoundLink("UI_GenericError", 0), PlayerGroupSingle(UnitGetOwner(EventUnit())), 100.0, 0.0);
    UIDisplayMessage(PlayerGroupSingle(UnitGetOwner(EventUnit())), c_messageAreaSubtitle, StringExternal("Param/Value/46984A6C"));
    Wait(1.0, c_timeGame);
    UnitAbilityEnable(EventUnit(), "Teleport", true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ZoneControl_Init () {
    gt_ZoneControl = TriggerCreate("gt_ZoneControl_Func");
    TriggerEnable(gt_ZoneControl, false);
    TriggerAddEventUnitRegion(gt_ZoneControl, null, RegionFromId(2), true);
    TriggerAddEventUnitRegion(gt_ZoneControl, null, RegionFromId(4), true);
    TriggerAddEventUnitRegion(gt_ZoneControl, null, RegionFromId(6), true);
    TriggerAddEventUnitRegion(gt_ZoneControl, null, RegionFromId(8), true);
    TriggerAddEventUnitRegion(gt_ZoneControl, null, RegionFromId(10), true);
    TriggerAddEventUnitRegion(gt_ZoneControl, null, RegionFromId(12), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Anti Cheat
//--------------------------------------------------------------------------------------------------
bool gt_AntiCheat_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) != "ZSZCZK"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "ZSZCZK_CASTER"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "HHBomber"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "PhoenixAiur"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "PrimalMutalisk"))) {
