    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_tAG_BZLock[EventPlayer()] == 0)) {
        gv_tAG_BZLock[EventPlayer()] = 1;
        UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, StringExternal("Param/Value/46AA097F"));
