//--------------------------------------------------------------------------------------------------
// Trigger: Pleasantly Surprised Sending
//--------------------------------------------------------------------------------------------------
bool gt_PleasantlySurprisedSending_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_spawncount > 6))) {
            return false;
        }

        if (!((GameAttributeGameValue("[bnet:local/0.0/177773]1") != "0002"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_spawncount < 41)) {
        libNtve_gf_SendTransmissionSimple(TransmissionSourceFromModel(null), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), gv_mSG[RandomInt(1, 23)], 6.0, c_transmissionDurationAdd, false);
        gv_pleasantlysurprised = TransmissionLastSent();
    }
    else {
        TransmissionClear(gv_pleasantlysurprised);
        TriggerEnable(gt_PleasantlySurprisedSending, false);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_PleasantlySurprisedSending_Init () {
    gt_PleasantlySurprisedSending = TriggerCreate("gt_PleasantlySurprisedSending_Func");
    TriggerEnable(gt_PleasantlySurprisedSending, false);
    TriggerAddEventTimer(gt_PleasantlySurprisedSending, gv_spawnTimer);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Mayday
//--------------------------------------------------------------------------------------------------
bool gt_Mayday_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((GameAttributeGameValue("[bnet:local/0.0/177773]1") != "0001"))) {
            return false;
        }

        if (!((GameAttributeGameValue("[bnet:local/0.0/177773]1") != "0013"))) {
            return false;
        }

        if (!((GameAttributeGameValue("[bnet:local/0.0/177773]1") != "0002"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromModel("BattlecruiserPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "Talk", SoundLink("Battlecruiser_Help", -1), StringExternal("Param/Value/9B891D8E"), StringExternal("Param/Value/105CFFB2"), 5.0, c_transmissionDurationAdd, false);
    Wait(6.0, c_timeGame);
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromModel("MarinePortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "Talk", SoundLink("Marine_EnterBunkerVO", -1), StringExternal("Param/Value/D954D777"), StringExternal("Param/Value/EB7AA0DE"), 5.0, c_transmissionDurationAdd, false);
    return true;
}

