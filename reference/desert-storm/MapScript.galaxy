    gt_Mayday = TriggerCreate("gt_Mayday_Func");
    TriggerEnable(gt_Mayday, false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Crashed Actor
//--------------------------------------------------------------------------------------------------
bool gt_CrashedActor_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    const int auto7CD377B6_n = 2;
    int auto7CD377B6_i;

    // Actions
    if (!runActions) {
        return true;
    }

    for (auto7CD377B6_i = 1; auto7CD377B6_i <= auto7CD377B6_n; auto7CD377B6_i += 1) {
        Wait(0.5, c_timeGame);
        libNtve_gf_CreateActorAtPoint("Aiur_CrashingDebris", RegionRandomPoint(RegionFromId(40)));
        libNtve_gf_CreateActorAtPoint("Aiur_CrashingDebris", RegionRandomPoint(RegionFromId(40)));
        PlayerCreateEffectPoint(7, "ZergDropPodCrashing", RegionRandomPoint(RegionFromId(40)));
        PlayerCreateEffectPoint(8, "ZergDropPodCrashing", RegionRandomPoint(RegionFromId(40)));
        libNtve_gf_CreateActorAtPoint("CharCrashingBarracks", RegionRandomPoint(RegionFromId(40)));
        Wait(0.5, c_timeGame);
        libNtve_gf_CreateActorAtPoint("Aiur_CrashingDebris", RegionRandomPoint(RegionFromId(40)));
        libNtve_gf_CreateActorAtPoint("Aiur_CrashingDebris", RegionRandomPoint(RegionFromId(40)));
        PlayerCreateEffectPoint(7, "ZergDropPodCrashing", RegionRandomPoint(RegionFromId(40)));
        PlayerCreateEffectPoint(8, "ZergDropPodCrashing", RegionRandomPoint(RegionFromId(40)));
        libNtve_gf_CreateActorAtPoint("CharCrashingBattlecruiser", RegionRandomPoint(RegionFromId(40)));
        Wait(0.5, c_timeGame);
        libNtve_gf_CreateActorAtPoint("Aiur_CrashingDebris", RegionRandomPoint(RegionFromId(40)));
        libNtve_gf_CreateActorAtPoint("Aiur_CrashingDebris", RegionRandomPoint(RegionFromId(40)));
        PlayerCreateEffectPoint(7, "ZergDropPodCrashing", RegionRandomPoint(RegionFromId(40)));
        PlayerCreateEffectPoint(8, "ZergDropPodCrashing", RegionRandomPoint(RegionFromId(40)));
        libNtve_gf_CreateActorAtPoint("CharCrashingDebris", RegionRandomPoint(RegionFromId(40)));
        Wait(0.5, c_timeGame);
        libNtve_gf_CreateActorAtPoint("Aiur_CrashingDebris", RegionRandomPoint(RegionFromId(40)));
        libNtve_gf_CreateActorAtPoint("Aiur_CrashingDebris", RegionRandomPoint(RegionFromId(40)));
        PlayerCreateEffectPoint(7, "ZergDropPodCrashing", RegionRandomPoint(RegionFromId(40)));
        PlayerCreateEffectPoint(8, "ZergDropPodCrashing", RegionRandomPoint(RegionFromId(40)));
        libNtve_gf_CreateActorAtPoint("CharCrashingFactory", RegionRandomPoint(RegionFromId(40)));
    }
    return true;
}

