    TriggerAddEventUnitAbility(gt_SpecialCostTexter, null, AbilityCommand("BuildGreaterNydusWorm", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_SpecialCostTexter, null, AbilityCommand("AbathurMend", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_SpecialCostTexter, null, AbilityCommand("SIStukovInfestStructureUpgraded", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_SpecialCostTexter, null, AbilityCommand("SOAMapWideChrono", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_SpecialCostTexter, null, AbilityCommand("AlarakACSummonDeathfleetTarget", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_SpecialCostTexter, null, AbilityCommand("SOAShadowGuardCalldown", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_SpecialCostTexter, null, AbilityCommand("RichMineral", 0), c_unitAbilStageExecute, false);
}

