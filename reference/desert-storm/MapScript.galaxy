// Trigger: CU_TimerWindowThresholdCrossed
//--------------------------------------------------------------------------------------------------
bool gt_CU_TimerWindowThresholdCrossed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TimerWindowSetTimer(TimerWindowLastCreated(), TimerLastStarted());
    if ((TimerGetRemaining(gv_cU_TimerWindowTimer) <= gv_cU_TimerWindowDangerThreshold) && (gv_cU_TimerWindowInDanger == false)) {
        gv_cU_TimerWindowInDanger = true;
        DialogControlSendAnimationEvent(gv_cU_TimerWindowHighlightFrame, PlayerGroupAll(), "Danger");
    }
    else if ((TimerGetRemaining(gv_cU_TimerWindowTimer) > gv_cU_TimerWindowDangerThreshold) && (gv_cU_TimerWindowInDanger == true)) {
        gv_cU_TimerWindowInDanger = false;
        DialogControlSendAnimationEvent(gv_cU_TimerWindowHighlightFrame, PlayerGroupAll(), "DangerStop");
    }
    return true;
}

