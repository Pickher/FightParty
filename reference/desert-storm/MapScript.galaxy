//--------------------------------------------------------------------------------------------------
// Trigger: Tactical-on 0
//--------------------------------------------------------------------------------------------------
bool gt_Tacticalon0_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_tacticalSwitch[UnitGetOwner(EventUnit())][0] == true)) {
        gv_tacticalSwitch[UnitGetOwner(EventUnit())][0] = false;
        libNtve_gf_SetUpgradeLevelForPlayer(UnitGetOwner(EventUnit()), "Tacticaloff0", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(UnitGetOwner(EventUnit()), "Tacticalon0", 1);
        DialogControlSetPosition(gv_e68898E69CAFE68C87E4BBA4E7B3BBE7BB9FE99DA2E69DBFEFBC9AE68C89E992AE[0], PlayerGroupSingle(EventPlayer()), c_anchorBottomLeft, 0, -78);
        if ((PlayerRace(UnitGetOwner(EventUnit())) == "Terr")) {
            UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, StringExternal("Param/Value/078ED9B8"));
        }
        else if ((PlayerRace(UnitGetOwner(EventUnit())) == "Zerg")) {
            UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, StringExternal("Param/Value/6FA6779B"));
        }
        else if ((PlayerRace(UnitGetOwner(EventUnit())) == "Prot")) {
            UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, StringExternal("Param/Value/41D18D40"));
        }
    }
    else {
        gv_tacticalSwitch[UnitGetOwner(EventUnit())][0] = true;
