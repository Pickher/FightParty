    // Automatic Variable Declarations
    // Variable Initialization
    lv_range = (UnitWeaponRange(EventPlayerEffectUsedUnit(c_effectUnitCaster), 1) + UnitTypeGetProperty(UnitGetType(EventPlayerEffectUsedUnit(c_effectUnitTarget)), c_unitPropRadius) + 0.5);

    // Actions
    if (!runActions) {
