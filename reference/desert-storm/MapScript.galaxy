//--------------------------------------------------------------------------------------------------
// Trigger: Teleport to Base
//--------------------------------------------------------------------------------------------------
bool gt_TeleporttoBase_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((gv_spawncount <= 61) && gf_E69DA1E4BBB6E8BF87E6BBA4E4B8A8E5B7A5E4BABAE58D95E4BD8D(EventUnit()) && (UnitGetOwner(EventUnit()) != 7) && (UnitGetOwner(EventUnit()) != 8)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_WorkerinBase(EventUnit());
    SoundPlay(SoundLink("Shuttle_Load", 0), PlayerGroupSingle(EventPlayer()), 100.0, 0.0);
    if ((PlayerGroupHasPlayer(gv_team1, UnitGetOwner(EventUnit())) == true)) {
        gf_TeleportDZ(EventPlayer(), 0, gv_startLocation[UnitGetOwner(EventUnit())]);
    }
    else {
        if ((PlayerGroupHasPlayer(gv_team2, UnitGetOwner(EventUnit())) == true)) {
            gf_TeleportDZ(EventPlayer(), 3, gv_startLocation[UnitGetOwner(EventUnit())]);
        }

    }
    UnitIssueOrder(EventUnit(), Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    UnitSetPosition(EventUnit(), gv_startLocation[UnitGetOwner(EventUnit())], false);
    if (((UnitGetType(EventUnit()) == "SCV") || (UnitGetType(EventUnit()) == "Probe") || (UnitGetType(EventUnit()) == "Drone"))) {
        if ((UnitHasBehavior2(gv_e5869BE8A194E690ADE6A1A3[UnitGetOwner(EventUnit())], "BOSS02VoidPylonPowerSourceOPEN") == false)) {
            UnitSetPosition(gv_e5869BE8A194E690ADE6A1A3[UnitGetOwner(EventUnit())], PointWithOffset(gv_startLocation[EventPlayer()], RandomFixed(-2.0, 2.0), RandomFixed(-2.0, 2.0)), true);
        }

    }

    return true;
}

