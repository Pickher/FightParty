    UnitIssueOrder(EventPlayerEffectUsedUnit(c_effectUnitCaster), OrderTargetingPoint(AbilityCommand("move", 0), libNtve_gf_PointOffsetTowardsPoint(UnitGetPosition(EventPlayerEffectUsedUnit(c_effectUnitTarget)), lv_range, UnitGetPosition(EventPlayerEffectUsedUnit(c_effectUnitCaster)))), c_orderQueueReplace);
    return true;
